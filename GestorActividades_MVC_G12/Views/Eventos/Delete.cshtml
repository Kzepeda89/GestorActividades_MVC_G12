@model GestorActividades_MVC_G12.Models.Evento
@{ ViewBag.Title = "Eliminar Actividad"; }

<div class="card border-danger shadow mt-4">
    <div class="card-header bg-danger text-white">
        <h3 class="mb-0">¿Confirmas la eliminación del evento?</h3>
    </div>
    <div class="card-body">
        <h4 class="text-danger">@Model.NombreEvento</h4>
        <p class="text-muted">Categoría: @Model.NombreCategoria | Cupos: @Model.CuposDisponibles</p>
        <hr />
        @using (Html.BeginForm())
        {
            @Html.HiddenFor(m => m.IdEvento)
            <button type="submit" class="btn btn-danger btn-lg px-4">Eliminar para siempre</button>
            @Html.ActionLink("No, mejor no", "Index", null, new { @class = "btn btn-outline-secondary btn-lg" })
        }
    </div>
</div>