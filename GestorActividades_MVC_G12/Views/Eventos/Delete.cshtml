@model GestorActividades_MVC_G12.Models.Evento

@{
    ViewBag.Title = "Eliminar Actividad";
}

<div class="container" style="margin-top:30px;">
    <div class="panel panel-danger">
        <div class="panel-heading">
            <h3 class="panel-title">¿Estás seguro de que deseas eliminar esta actividad?</h3>
        </div>
        <div class="panel-body">
            <dl class="dl-horizontal">
                <dt>Evento:</dt>
                <dd>@Html.DisplayFor(model => model.NombreEvento)</dd>

                <dt>Categoría:</dt>
                <dd>@Html.DisplayFor(model => model.NombreCategoria)</dd>

                <dt>Cupos:</dt>
                <dd>@Html.DisplayFor(model => model.CuposDisponibles)</dd>
            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="form-actions no-color">
                    <input type="submit" value="Sí, Eliminar Registro" class="btn btn-danger" />
                    @Html.ActionLink("No, Regresar al Listado", "Index", null, new { @class = "btn btn-default" })
                </div>
            }
        </div>
    </div>
</div>