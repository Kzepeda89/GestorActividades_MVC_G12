@model GestorActividades_MVC_G12.Models.Evento
@{ ViewBag.Title = "Nueva Actividad"; }

<div class="container" style="margin-top:50px; max-width:500px;">
    <div class="panel panel-success shadow">
        <div class="panel-heading"><h3>Registrar Nueva Actividad</h3></div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                <div class="form-group">
                    <label>Nombre del Evento</label>
                    @Html.TextBoxFor(m => m.NombreEvento, new { @class = "form-control", placeholder = "Ej. Torneo de Ajedrez" })
                </div>
                <div class="form-group">
                    <label>Cupos Disponibles</label>
                    @Html.TextBoxFor(m => m.CuposDisponibles, new { @class = "form-control", type = "number" })
                </div>
                <br />
                <button type="submit" class="btn btn-success btn-block">Guardar Actividad</button>
                @Html.ActionLink("Cancelar y Regresar", "Index", null, new { @class = "btn btn-default btn-block" })
            }
        </div>
    </div>
</div>