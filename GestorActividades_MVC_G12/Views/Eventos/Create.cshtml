@model GestorActividades_MVC_G12.Models.Evento
@{ ViewBag.Title = "Nuevo Registro"; }

<div class="card shadow mt-4">
    <div class="card-header bg-success text-white"><h3>Registrar Actividad</h3></div>
    <div class="card-body">
        @using (Html.BeginForm())
        {
            <div class="mb-3">
                <label class="form-label fw-bold">Nombre del Evento</label>
                @Html.TextBoxFor(m => m.NombreEvento, new { @class = "form-control" })
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Categoría</label>
                @Html.DropDownListFor(m => m.IdCategoria, (IEnumerable<SelectListItem>)ViewBag.ListaCategorias, "-- Seleccione Categoria --", new { @class = "form-select" })
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Cupos Disponibles</label>
                @Html.TextBoxFor(m => m.CuposDisponibles, new { @class = "form-control", type = "number" })
            </div>
            <button type="submit" class="btn btn-success w-100">Guardar Actividad</button>
            <div class="text-center mt-2">
                @Html.ActionLink("Regresar al Listado", "Index")
            </div>
        }
    </div>
</div>