@model IEnumerable<GestorActividades_MVC_G12.Models.Evento>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-secondary fw-bold">Administración de Actividades</h2>
    @Html.ActionLink("Registrar Nueva Actividad", "Create", null, new { @class = "btn btn-outline-primary" })
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-dark text-white">
        <h5 class="mb-0">Listado Oficial de Eventos</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Eventos Disponibles</th>
                    <th>Categoría</th>
                    <th>Cupos</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.IdEvento</td>
                        <td>@item.NombreEvento</td>
                        <td><span class="badge bg-info text-dark">@item.NombreCategoria</span></td>
                        <td>@item.CuposDisponibles</td>
                        <td class="text-center">
                            @Html.ActionLink("Editar", "Edit", new { id = item.IdEvento }, new { @class = "btn btn-sm btn-warning me-2" })
                            @Html.ActionLink("Eliminar", "Delete", new { id = item.IdEvento }, new { @class = "btn btn-sm btn-danger", onclick = "return confirm('¿Borrar?')" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>