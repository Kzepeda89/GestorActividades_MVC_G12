@model GestorActividades_MVC_G12.Models.Evento

@{
    ViewBag.Title = "Registrar Nueva Actividad";
}

<div class="container" style="margin-top:30px;">
    <div class="panel panel-primary">
        <div class="panel-heading">
            <h3 class="panel-title">Nueva Actividad</h3>
        </div>
        <div class="panel-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="control-label col-md-2">Nombre del Evento</label>
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.NombreEvento, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-2">Cupos Disponibles</label>
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.CuposDisponibles, new { htmlAttributes = new { @class = "form-control", type = "number" } })
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10">
                            <input type="submit" value="Guardar Actividad" class="btn btn-success" />
                            @Html.ActionLink("Regresar al Listado", "Index", null, new { @class = "btn btn-default" })
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>