@model GestorActividades_MVC_G12.Models.Evento
@{ ViewBag.Title = "Editar Actividad"; }

<div class="card shadow mt-4">
    <div class="card-header bg-primary text-white">
        <h3 class="mb-0">Modificando: <span class="text-warning">@Model.NombreEvento</span></h3>
    </div>
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.HiddenFor(m => m.IdEvento)
            <div class="mb-3">
                <label class="form-label fw-bold">Nombre del Evento</label>
                @Html.TextBoxFor(m => m.NombreEvento, new { @class = "form-control" })
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Categoría</label>
                @Html.DropDownListFor(m => m.IdCategoria, (IEnumerable<SelectListItem>)ViewBag.ListaCategorias, new { @class = "form-select" })
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Cupos Disponibles</label>
                @Html.TextBoxFor(m => m.CuposDisponibles, new { @class = "form-control", type = "number" })
            </div>
            <div class="d-grid gap-2 d-md-block">
                <button type="submit" class="btn btn-success px-5">Guardar Cambios</button>
                @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
            </div>
        }
    </div>
</div>