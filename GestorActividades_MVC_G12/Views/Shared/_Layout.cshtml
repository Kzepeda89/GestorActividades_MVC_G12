<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Sistema G12</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        :root {
            --primary-dark: #1e293b; /* Slate 800 */
            --accent-color: #3b82f6; /* Blue 500 */
            --bg-body: #f8fafc;
        }

        body {
            background-color: var(--bg-body);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .navbar-custom {
            background-color: var(--primary-dark);
            border-bottom: 3px solid var(--accent-color);
        }

        .navbar-brand {
            font-weight: 800;
            letter-spacing: 1px;
        }

        .nav-link {
            font-weight: 500;
            transition: all 0.3s;
            margin: 0 5px;
        }

            .nav-link:hover {
                color: var(--accent-color) !important;
                transform: translateY(-1px);
            }

        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }

        .btn-primary {
            background-color: var(--accent-color);
            border: none;
        }

            .btn-primary:hover {
                background-color: #2563eb;
            }

        footer {
            background-color: #ffffff;
            border-top: 1px solid #e2e8f0;
            color: #64748b;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top shadow">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="@Url.Action("DashBoard", "Acceso")">
                <i class="bi bi-shield-check me-2"></i> GESTOR UTEC
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("DashBoard", "Acceso")"><i class="bi bi-house-door me-1"></i> Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Eventos")"><i class="bi bi-calendar-event me-1"></i> Eventos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Inscripciones")"><i class="bi bi-people me-1"></i> Inscripciones</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center">
                    <span class="text-light opacity-75 me-3 small">
                        <i class="bi bi-person-circle me-1"></i> @Session["Usuario"]
                    </span>
                    <a href="@Url.Action("Logout", "Acceso")" class="btn btn-outline-light btn-sm fw-bold">
                        <i class="bi bi-box-arrow-right"></i> Salir
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container my-5">
        @RenderBody()
    </div>

    <footer class="py-4 mt-auto">
        <div class="container text-center">
            <p class="mb-1 fw-bold">Programación 2 - Grupo 12</p>
            <p class="small mb-0">© @DateTime.Now.Year Universidad Tecnológica de El Salvador</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>