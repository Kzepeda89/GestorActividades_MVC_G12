@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <title>Login - Gestor Actividades</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5" style="max-width: 400px;">
        <div class="card shadow">
            <div class="card-body">
                <h3 class="text-center mb-4">Acceso al Sistema</h3>
                @using (Html.BeginForm("Login", "Acceso", FormMethod.Post))
                {
                    <div class="mb-3">
                        <label>Usuario (Carnet):</label>
                        <input type="text" name="usuario" class="form-control" placeholder="Ej: 29-1757-2015" />
                    </div>
                    <div class="mb-3">
                        <label>Contraseña:</label>
                        <input type="password" name="clave" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Iniciar Sesión</button>
                }
            </div>
        </div>
    </div>
</body>
</html>