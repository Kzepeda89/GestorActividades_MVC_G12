@{ ViewBag.Title = "Panel de Control"; }

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold text-dark">Bienvenido, @Session["Usuario"]</h2>
        <p class="text-secondary">Resumen ejecutivo del sistema de actividades.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 p-3 border-start border-4 border-primary">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                    <i class="bi bi-calendar-check text-primary fs-3"></i>
                </div>
                <div>
                    <h6 class="card-subtitle mb-1 text-muted fw-bold text-uppercase" style="font-size: 0.75rem;">Eventos Activos</h6>
                    <h2 class="card-title mb-0 fw-bold">@ViewBag.TotalEventos</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100 p-3 border-start border-4 border-info">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
                    <i class="bi bi-person-badge text-info fs-3"></i>
                </div>
                <div>
                    <h6 class="card-subtitle mb-1 text-muted fw-bold text-uppercase" style="font-size: 0.75rem;">Total Alumnos</h6>
                    <h2 class="card-title mb-0 fw-bold">@ViewBag.TotalInscritos</h2>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-5 p-5 bg-white rounded-4 shadow-sm">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h4 class="fw-bold">Reporte de Gestión I-2026</h4>
            <p class="text-secondary">Utilice el menú superior para administrar las categorías, modificar cupos o registrar nuevos participantes en las actividades extracurriculares.</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Index", "Eventos")" class="btn btn-primary px-4 py-2 rounded-pill">Gestionar Ahora</a>
        </div>
    </div>
</div>