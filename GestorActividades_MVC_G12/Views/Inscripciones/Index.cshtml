@model IEnumerable<GestorActividades_MVC_G12.Controllers.VistaInscripcion>
@{ ViewBag.Title = "Registro de Inscripciones"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Participantes Inscritos</h2>
        @Html.ActionLink("Regresar a Eventos", "Index", "Eventos", null, new { @class = "btn btn-outline-primary" })
    </div>

    <div class="card shadow border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Carnet</th>
                        <th>Nombre del Estudiante</th>
                        <th>Actividad Seleccionada</th>
                        <th>Fecha de Registro</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Carnet</td>
                            <td>@item.Estudiante</td>
                            <td><span class="badge bg-info text-dark">@item.Actividad</span></td>
                            <td>@item.Fecha</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>